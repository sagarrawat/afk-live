# Caddy in front of the web app's two deploy slots (OPS-4, zero-downtime deploys). Install as /etc/caddy/Caddyfile
# after replacing afk.live with your domain, then: sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Setup and how a deploy uses this: docs/operations.md ("Web deploys without downtime").

# Both slots; normally only one runs. Caddy asks each for its readiness every second and sends requests only to a
# ready one ("first": the first ready slot in this list). A slot that is stopping reports "not ready" for 5 s
# before it closes its port, so new requests move first; a request that still meets a closed port is retried on
# the other slot for up to 10 s instead of failing.
(afklive_web) {
	reverse_proxy 127.0.0.1:8080 127.0.0.1:8090 {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 5s

		health_uri /actuator/health/readiness
		health_interval 1s
		health_timeout 2s
		health_status 200
	}
}

afk.live, www.afk.live {
	@www host www.afk.live
	redir @www https://afk.live{uri} permanent

	# The probes are for this machine only (the app refuses them to proxied requests too).
	@actuator path /actuator /actuator/*
	respond @actuator 404

	encode zstd gzip
	request_body {
		max_size 10GB
	}
	import afklive_web
}

# The ingest server's auth hook (MediaMTX on this machine): authHTTPAddress http://127.0.0.1:8079/internal/ingest/auth?secret=...
# It must not point at one slot's port, because that slot is stopped by the next deploy. Localhost only; not logged.
http://127.0.0.1:8079 {
	bind 127.0.0.1
	@actuator path /actuator /actuator/*
	respond @actuator 404
	import afklive_web
}
