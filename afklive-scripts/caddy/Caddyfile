# Caddy in front of the web app's two deploy slots (OPS-4, zero-downtime deploys). Install as /etc/caddy/Caddyfile
# (the domain is afklive.in; change it if yours differs), then:
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# Setup and how a deploy uses this: docs/operations.md ("Web deploys without downtime").

# Both slots; normally only one runs. Caddy asks each for its readiness every second and sends requests only to a
# ready one ("first": the first ready slot in this list). A slot that is stopping reports "not ready" for 5 s
# before it closes its port, so new requests move first; a request that still meets a closed port is retried on
# the other slot for up to 10 s instead of failing.
(afklive_web) {
	reverse_proxy 127.0.0.1:8080 127.0.0.1:8090 {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 5s

		health_uri /actuator/health/readiness
		health_interval 1s
		health_timeout 2s
		health_status 200
	}
}

# While the web app restarts, visitors get a page that says so (and reloads itself), not the browser's bare
# "502". Only Caddy's own errors land here (no upstream answering: 502, 503 no healthy slot, 504 timeout);
# what the app answers itself, a 503 included, passes through untouched. API calls get JSON the app's fetch
# layer understands (afklive-ui/src/lib/api.ts). The page: afklive-scripts/caddy/errors/index.html, uploaded by
# every web deploy to /opt/afklive/errors/. docs/operations.md, "While the web app restarts".
# The same block is in Caddyfile.single-upstream (a test keeps them equal).
# --- afklive_updating ---
(afklive_updating) {
	handle_errors 502 503 504 {
		header Cache-Control "no-store"
		header Retry-After "30"

		@api path /api /api/*
		handle @api {
			header Content-Type "application/json"
			respond `{"error":"updating","retryAfter":30}` 503
		}

		@page header Accept *text/html*
		handle @page {
			root * /opt/afklive/errors
			rewrite * /index.html
			file_server {
				status 503
			}
		}

		handle {
			respond "AFK Live is updating. Back in about a minute." 503
		}
	}
}
# --- end afklive_updating ---

# SEO: one address for the site. http:// and www. answer with a single 301 to https://afklive.in, path and
# query kept (Caddy's own http->https redirect is a 308 and would leave www as a second hop). Certificates
# are still issued for both names: ACME challenges are answered before these redirects.
http://afklive.in, http://www.afklive.in {
	redir https://afklive.in{uri} permanent
}

afklive.in, www.afklive.in {
	@www host www.afklive.in
	redir @www https://afklive.in{uri} permanent

	# The probes are for this machine only (the app refuses them to proxied requests too).
	@actuator path /actuator /actuator/*
	respond @actuator 404

	encode zstd gzip
	request_body {
		max_size 10GB
	}
	import afklive_web
	import afklive_updating
}

# The ingest server's auth hook (MediaMTX on this machine): authHTTPAddress http://127.0.0.1:8079/internal/ingest/auth?secret=...
# It must not point at one slot's port, because that slot is stopped by the next deploy. Localhost only; not logged.
http://127.0.0.1:8079 {
	bind 127.0.0.1
	@actuator path /actuator /actuator/*
	respond @actuator 404
	import afklive_web
}
