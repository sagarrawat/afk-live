# Stream worker: runs FFmpeg for live streams. Deployed separately and rarely (see docs/operations.md).
# Superseded by the slot units afklive-worker@.service (OPS-3: deploys without interrupting streams);
# the first handover deploy moves its streams to slot b and disables this unit. Kept for the migration.
# On restart it resumes its own streams (same STREAMING_WORKER_ID); if it never returns, another
# worker takes them over within about a minute.
# Install: sudo cp afklive-worker.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now afklive-worker
[Unit]
Description=AFK Live stream worker
After=network-online.target
Wants=network-online.target

[Service]
# A separate user lets the egress firewall (afklive-scripts/worker-egress.nft) apply to FFmpeg only.
User=afklive-worker
WorkingDirectory=/opt/afklive/worker
EnvironmentFile=/opt/afklive/afklive.env
# Role, profiles and worker id are -D properties: they win over anything in afklive.env (EnvironmentFile overrides Environment=).
# The id is the host name, so a restarted worker resumes its own streams. Run one worker per host.
ExecStart=/usr/bin/java -Xmx512m -Dspring.profiles.active=worker,loki -Dapp.streaming.role=worker -Dapp.streaming.worker-id=%H -jar /opt/afklive/worker/app.jar
# Give running streams time to close cleanly on stop.
TimeoutStopSec=20
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
