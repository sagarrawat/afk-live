# Runs afklive-db-backup.service every night. Persistent=true runs a missed backup after a reboot.
[Unit]
Description=Nightly AFK Live database backup

[Timer]
# 21:30 UTC = 03:00 IST, the quietest hour for Indian creators.
OnCalendar=*-*-* 21:30:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
