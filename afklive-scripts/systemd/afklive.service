# Web app (API + site), single unit. Restarting it never interrupts live streams: those run in afklive-worker.
# Superseded by the deploy slots afklive-web@a / @b (OPS-4, zero-downtime deploys): the first deploy with
# afklive-scripts/web-deploy.sh moves from this unit to slot b and disables it. Kept for servers not set up yet.
# Install: sudo cp afklive.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now afklive
[Unit]
Description=AFK Live web app
After=network-online.target
Wants=network-online.target

[Service]
User=afklive
WorkingDirectory=/opt/afklive
EnvironmentFile=/opt/afklive/afklive.env
# Role and profiles are -D properties: they win over anything in afklive.env (EnvironmentFile overrides Environment=).
ExecStart=/usr/bin/java -Xmx1g -Dapp.streaming.role=web -Dspring.profiles.active=loki -jar /opt/afklive/app.jar
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
