{
  "title": "AFK Live - Stream Operations",
  "uid": "operations-dashboard",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Active Streams",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "afk_active_streams", "refId": "A"}]
