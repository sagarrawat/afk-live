    {
      "type": "stat",
      "title": "Dropped Frames",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "rate(stream_dropped_frames_total[5m])", "refId": "A"}]
    }
  ]
}
